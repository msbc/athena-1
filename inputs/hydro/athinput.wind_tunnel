<comment>
problem   = Wind tunnel with hdf5 IC loading
configure = --prob wind_tunnel -hdf5 --nscalars 1

<job>
problem_id  = wind         # problem ID: basename of output filenames

<output1>
file_type   = rst          # Restart dump
dt          = 10.0         # time increment between outputs

<output2>
file_type   = hdf5         # HDF5 data dump
variable    = prim         # variables to be output
dt          = 0.1          # time increment between outputs
xdmf        = false        # write an XDMF file for visualization

#<output3>
#file_type   = hdf5         # HDF5 data dump
#variable    = uov          # variables to be output
#dt          = 1e2          # time increment between outputs
#xdmf        = false        # write an XDMF file for visualization

<time>
cfl_number  = 0.4          # The Courant, Friedrichs, & Lewy (CFL) Number
nlim        = -1           # cycle limit
tlim        = 1.0e2        # time limit (300 orbits)
integrator  = vl2          # time integration algorithm
xorder      = 2            # order of spatial reconstruction
ncycle_out  = 1            # interval for stdout summary info

<mesh>
nx1         = 19200        # Number of zones in X1-direction
x1min       = 0.0          # minimum value of X1
x1max       = 40.0         # maximum value of X1
ix1_bc      = outflow      # inner-X1 boundary flag
ox1_bc      = user         # outer-X1 boundary flag

nx2         = 4320         # Number of zones in X2-direction
x2min       = 0.0          # minimum value of X2
x2max       = 9.0          # maximum value of X2
ix2_bc      = reflecting   # inner-X2 boundary flag
ox2_bc      = reflecting   # outer-X2 boundary flag

nx3         = 1            # Number of zones in X3-direction
x3min       = 0.0          # minimum value of X3
x3max       = 1.0          # maximum value of X3
ix3_bc      = reflecting   # inner-X3 boundary flag
ox3_bc      = reflecting   # outer-X3 boundary flag

num_threads = 1            # maximum number of OMP threads

<meshblock>
nx1 = 240
nx2 = 240
nx3 = 1

<hydro>
gamma = 1.666666666666667  # gamma = C_p/C_v
iso_sound_speed = 1.0
dfloor          = 1.e-6
pfloor          = 1.e-6

<problem>
input_filename = input.h5  # HDF5 file containing initial conditions
dataset        = data      # dataset name in the HDF5 file
rho0 = 1.0                 # background density
p0   = 1.0                 # background pressure
mach = 3.0                 # Mach number of the flow
